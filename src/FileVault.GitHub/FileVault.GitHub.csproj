<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>GitHub repository provider for FileVault. Implements IFileProvider over one branch of a repository through the GitHub REST API: every write is one atomic commit, Git LFS files are read transparently, and the commit history of the branch and of single files is available for history views.</Description>
    <PackageTags>file-manager;file-provider;github;git;git-lfs;cloud;storage</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileVault.Core\FileVault.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FileVault.GitHub.Tests" />
  </ItemGroup>

</Project>
